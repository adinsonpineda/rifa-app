# Copia este archivo como ".env" y configura tu conexion a MongoDB.
# Tienes DOS opciones, usa una u otra (no ambas):

# ---------------------------------------------------------------
# OPCION A: una sola cadena de conexion completa
# ---------------------------------------------------------------
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/rifa
#
# MongoDB Atlas (nube, gratis):
# MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/rifa?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/rifa

# ---------------------------------------------------------------
# OPCION B (recomendada si tienes errores de "bad auth"): variables
# separadas. El codigo arma la cadena y codifica automaticamente
# cualquier caracter especial en el usuario/contraseña, evitando
# errores de copiado/pegado. Si defines estas 3, tienen prioridad
# sobre MONGODB_URI de arriba.
# ---------------------------------------------------------------
# MONGODB_USER=tuUsuarioDeDatabaseAccess
# MONGODB_PASSWORD=tuContraseña
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_DB=rifa

# Puerto donde correra el servidor
PORT=3000

# Cantidad total de numeros de la rifa (por defecto 100)
TOTAL_NUMBERS=100
