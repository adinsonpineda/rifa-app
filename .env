# Copia este archivo como ".env" y coloca tu cadena de conexion real de MongoDB

# Ejemplo local:
# MONGODB_URI=mongodb://127.0.0.1:27017/rifa

# Ejemplo con MongoDB Atlas (nube, gratis):
# MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/rifa?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/rifa

# Puerto donde correra el servidor
PORT=3000

# Cantidad total de numeros de la rifa (por defecto 100)
TOTAL_NUMBERS=100
